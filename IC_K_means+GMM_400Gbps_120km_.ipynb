    "    sym_X_test = aux.astype(int)\n",
    "    # Y polarization\n",
    "    aux = 4*np.clip(np.round((Y_test[:,2]-1)/2)+2,0,3)+np.clip(np.round((Y_test[:,3]-1)/2)+2,0,3)\n",
    "    sym_Y_test = aux.astype(int)\n",
    "\n",
    "    # Detection of the real symbols\n",
